# Residencial Park Club - variaveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.

# Settings module (produção: parkclub.settings_prod)
DJANGO_SETTINGS_MODULE=parkclub.settings_prod

# Chave secreta do Django (gere uma forte e unica por ambiente)
SECRET_KEY=troque-por-uma-chave-forte-unica

# Hosts permitidos (separados por virgula) - apenas dev
# ALLOWED_HOSTS=*

# Banco - container web (Django)
DB_HOST=db
DB_PORT=5432
DB_NAME=residencialparkclub
DB_USER=enterprise_user
DB_PASSWORD=defina-uma-senha-forte

# Banco - container postgres (devem casar com DB_* acima)
POSTGRES_DB=residencialparkclub
POSTGRES_USER=enterprise_user
POSTGRES_PASSWORD=defina-uma-senha-forte
